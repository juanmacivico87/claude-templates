{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(tail:*)"
    ],
    "ask": [
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(rm:*)",
      "Bash(rm -rf:*)",
      "Bash(npm install:*)",
      "Bash(composer install:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git reset --hard:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git commit:*)",
      "Bash(git commit --amend:*)",
      "Bash(git clean -f:*)"
    ]
  }
}